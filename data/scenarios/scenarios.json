{
  "_note": "Agent evaluation scenarios (synthetic). Each runs on a freshly seeded DB. In REPLAY mode the replay_script plays the model's turns (no API call); in LIVE mode the real model decides and replay_script is ignored. Expectations check authoritative DB state, not wording. live=false scenarios simulate model/API failures that cannot be triggered on demand against the real API.",
  "scenarios": [
    {
      "id": "S01", "title": "Complete order confirmation", "test_cases": ["TC-01"], "live": true,
      "events": [
        {"order_id": "ORD-1001", "event_id": "EVT-S01-1", "text": "السلام عليكم، عايزة أأكد الأوردر لو سمحت",
         "replay_script": [
           {"tool_calls": [{"name": "request_confirmation", "input": {}}]},
           {"text": "Sent the system confirmation summary (v1)."}],
         "expect": {"orders": {"ORD-1001": {"lifecycle_state": "VERIFIED", "agent_outcome": "ON_HOLD"}},
                    "counts": [{"sql": "SELECT COUNT(*) FROM confirmation_requests WHERE order_id='ORD-1001' AND status='OPEN'", "eq": 1}]}},
        {"order_id": "ORD-1001", "event_id": "EVT-S01-2", "text": "تمام",
         "replay_script": [
           {"tool_calls": [{"name": "record_confirmation", "input": {}}]},
           {"tool_calls": [{"name": "commit_ready", "input": {}}]},
           {"tool_calls": [{"name": "send_customer_message", "input": {"kind": "INFO", "text": "تم تأكيد طلبك وهيتجهز للشحن. شكرًا ليك!"}}]},
           {"text": "Confirmation accepted, order committed READY_FOR_DISPATCH."}],
         "expect": {"orders": {"ORD-1001": {"lifecycle_state": "READY_FOR_DISPATCH", "agent_outcome": "READY_FOR_DISPATCH"}},
                    "stock": {"HOODIE-BLK-L": 4},
                    "counts": [{"sql": "SELECT COUNT(*) FROM stock_reservations", "eq": 1}]}}
      ]
    },
