# Copy to .env (git-ignored; never commit it). Only needed for LIVE mode.
# REPLAY mode and the tests need no credentials. Only the variable names referenced by
# api_key_env in config/settings.toml profiles (and COD_RESCUE_*) are read from this file.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides
# COD_RESCUE_LLM_PROFILE=openrouter-gemma-free
# COD_RESCUE_DB_PATH=data/cod_rescue.sqlite3
